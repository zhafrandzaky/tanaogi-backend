APP_NAME=TanaOgi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAINTENANCE_SECRET=rahasia_tanaogi_admin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (local: mysql container | Railway: ${{tanaogi-db.MYSQL*}}) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tanaogi
DB_USERNAME=tanaogi_user
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database

CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost:5173

# --- Cloudflare R2 Storage ---
# Dev bucket: tanaogi-storage-dev | Prod bucket: tanaogi-storage
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=tanaogi-storage-dev
CLOUDFLARE_R2_ENDPOINT=https://{account_id}.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://dev-storage.tanaogi.zyy.my.id

# --- WhatsApp (WaAPI self-hosted) ---
ADMIN_WHATSAPP=628xxxxxxxxxx
WAAPI_URL=https://waapi.fyas.my.id
WAAPI_KEY=wapi_your_key_here

# --- Mail (local: mailpit | production: SMTP e.g. Resend) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@tanaogi.zyy.my.id
MAIL_FROM_NAME=TanaOgi

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# Production (Railway) — set these in Railway Variables tab,
# NOT in this file. This file is for local development only.
#
# APP_ENV=production
# APP_DEBUG=false
# LOG_CHANNEL=stderr
# DB_HOST=${{tanaogi-db.MYSQLHOST}}
# DB_PORT=${{tanaogi-db.MYSQLPORT}}
# DB_DATABASE=${{tanaogi-db.MYSQLDATABASE}}
# DB_USERNAME=${{tanaogi-db.MYSQLUSER}}
# DB_PASSWORD=${{tanaogi-db.MYSQLPASSWORD}}
# SANCTUM_STATEFUL_DOMAINS=tanaogi.zyy.my.id
# CLOUDFLARE_R2_BUCKET=tanaogi-storage
# CLOUDFLARE_R2_URL=https://storage.tanaogi.zyy.my.id
# CORS_ALLOWED_ORIGINS=https://tanaogi.zyy.my.id
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_USERNAME=resend
# MAIL_PASSWORD=<resend_api_key>
# ============================================================
